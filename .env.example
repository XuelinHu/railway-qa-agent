APP_NAME=Railway QA Agent
APP_ENV=development
API_PREFIX=/api
AUTO_CREATE_TABLES=true

# PostgreSQL conversation storage.
# Replace <YOUR_PASSWORD> locally. Do not commit real credentials.
# If the password contains @, encode it as %40 inside DATABASE_URL.
POSTGRES_USER=deipss
POSTGRES_PASSWORD=<YOUR_PASSWORD>
POSTGRES_DB=railway_qa_agent
DATABASE_URL=postgresql+asyncpg://deipss:<YOUR_PASSWORD>@localhost:5432/railway_qa_agent

# Qdrant vector store.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=railway_knowledge
QDRANT_TIMEOUT_SECONDS=8
RAG_VECTOR_ENABLED=true
RETRIEVAL_LIMIT=6

# --- Accounts ---------------------------------------------------------------
# Signing key for the access and refresh tokens. Generate one per deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# A default value is used in development so the app starts, but the backend
# logs a warning on every startup until this is set.
JWT_SECRET=<GENERATE_A_RANDOM_SECRET>
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=120
JWT_REFRESH_TTL_DAYS=7
REFRESH_COOKIE_NAME=railway_refresh
# Failed sign-ins before the account is locked, and for how long.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Created once, only when the users table is empty. The account is flagged
# must-change-password, so the first sign-in is forced through a password reset.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=<YOUR_INITIAL_ADMIN_PASSWORD>
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员

# --- LLM --------------------------------------------------------------------
# auto | ollama | openai. `auto` picks ollama when LLM_BASE_URL looks like an
# ollama endpoint, otherwise any OpenAI-compatible chat completions service.
LLM_PROVIDER=auto
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
# Read timeout while streaming. A cold model load can pause for minutes before
# the first token on a GPU shared with other work.
LLM_STREAM_TIMEOUT_SECONDS=300
LLM_KEEP_ALIVE=30m
LLM_NUM_CTX=8192
# Ask reasoning models (qwen3, deepseek-r1) to narrate their thinking.
LLM_THINK=false

# --- Ollama model management ------------------------------------------------
# Drives the model list, switching, load/unload and online pull in the console.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=30

# Embedding and reranking models.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=16
RERANKER_MODEL=

# --- Speech (optional) ------------------------------------------------------
# These need the optional extra:  pip install -e ".[speech]"
# Without it the app still starts and the endpoints report themselves
# unavailable, so the browser-side engines are used on their own.
SPEECH_ASR_ENABLED=true
SPEECH_ASR_MODEL=small
# The GPU is often busy; transcription defaults to CPU with int8 weights.
SPEECH_ASR_DEVICE=cpu
SPEECH_ASR_COMPUTE_TYPE=int8
SPEECH_ASR_CPU_THREADS=4
SPEECH_ASR_IDLE_UNLOAD_SECONDS=900
SPEECH_TTS_ENABLED=true
SPEECH_TTS_VOICE=zh-CN-XiaoxiaoNeural
SPEECH_TTS_RATE=+0%
SPEECH_TTS_MAX_CHARS=1000
SPEECH_CACHE_DIR=data/tts_cache

# --- Outbound mail (optional) -----------------------------------------------
# Without SMTP, a forgotten password records a reset request that an
# administrator handles from the console, instead of pretending to send mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# Used to build the reset link that is mailed out.
PUBLIC_BASE_URL=http://127.0.0.1:4023

# Comma-separated. Must list every origin the browser loads the app from.
CORS_ORIGINS=http://localhost:4023,http://127.0.0.1:4023

# Frontend.
VITE_API_BASE_URL=/api
